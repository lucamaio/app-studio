<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StudySpace.App.Controls" x:Class="StudySpace.App.Controls.EmptyStateView" x:Name="Root">
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource Space16}" HorizontalOptions="Center" MaximumWidthRequest="{StaticResource EmptyStateWidth}">
            <Label Text="◇" FontSize="{StaticResource FontEmptyIcon}" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Heading, Source={x:Reference Root}, x:DataType=local:EmptyStateView}" Style="{StaticResource Subheading}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Message, Source={x:Reference Root}, x:DataType=local:EmptyStateView}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Border>
</ContentView>

