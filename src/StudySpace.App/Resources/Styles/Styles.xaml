<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
 <Style TargetType="ContentPage" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight},Dark={StaticResource CanvasDark}}" /></Style>
 <Style x:Key="BaseLabel" TargetType="Label">
  <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" />
  <Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource FontBody}" /><Setter Property="LineBreakMode" Value="WordWrap" />
 </Style>
 <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />
 <Style x:Key="Heading" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="FontFamily" Value="{StaticResource SemiboldFont}" /><Setter Property="FontSize" Value="{StaticResource FontHeading}" /></Style>
 <Style x:Key="Subheading" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="FontFamily" Value="{StaticResource SemiboldFont}" /><Setter Property="FontSize" Value="{StaticResource FontTitle}" /></Style>
 <Style x:Key="QuestionHeading" TargetType="Label" BasedOn="{StaticResource Heading}"><Setter Property="FontSize" Value="{StaticResource FontQuestion}" /><Setter Property="LineHeight" Value="1.25" /></Style>
 <Style x:Key="Strong" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="FontFamily" Value="{StaticResource SemiboldFont}" /></Style>
 <Style x:Key="Muted" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight},Dark={StaticResource MutedDark}}" /></Style>
 <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="{StaticResource FontCaption}" /></Style>
 <Style x:Key="Error" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /><Setter Property="FontSize" Value="{StaticResource FontSmall}" /></Style>
 <Style x:Key="Success" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></Style>
 <Style x:Key="Warning" TargetType="Label" BasedOn="{StaticResource BaseLabel}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight},Dark={StaticResource WarningDark}}" /></Style>
 <Style x:Key="BaseButton" TargetType="Button">
  <Setter Property="FontFamily" Value="{StaticResource SemiboldFont}" /><Setter Property="FontSize" Value="{StaticResource FontSmall}" />
  <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}" /><Setter Property="Padding" Value="{StaticResource ButtonInset}" />
  <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" /><Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTarget}" /><Setter Property="LineBreakMode" Value="WordWrap" />
  <Setter Property="BorderWidth" Value="1" /><Setter Property="BorderColor" Value="{StaticResource Clear}" />
  <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
   <VisualState x:Name="Normal" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="BorderWidth" Value="2" /></VisualState.Setters></VisualState>
   <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight},Dark={StaticResource DisabledSurfaceDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight},Dark={StaticResource BorderDark}}" /><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState>
  </VisualStateGroup></VisualStateGroupList></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource PrimaryDark}}" /><Setter Property="TextColor" Value="{StaticResource OnPrimary}" /></Style>
 <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
 <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="BackgroundColor" Value="{StaticResource Clear}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource AccentDark}}" /><Setter Property="Padding" Value="{StaticResource QuietButtonInset}" /></Style>
 <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight},Dark={StaticResource SurfaceDark}}" /><Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight},Dark={StaticResource BorderDark}}" /></Style>
 <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="MinimumHeightRequest" Value="{StaticResource PrimaryTouchTarget}" /></Style>
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></Style>
 <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="FontSize" Value="{StaticResource FontTitle}" /><Setter Property="Padding" Value="{StaticResource Inset4}" /></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight},Dark={StaticResource SurfaceDark}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight},Dark={StaticResource BorderDark}}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="{StaticResource CardShape}" /><Setter Property="Padding" Value="{StaticResource CardInset}" /></Style>
 <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="{StaticResource Inset16}" /></Style>
 <Style x:Key="TagPill" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElevatedLight},Dark={StaticResource ElevatedDark}}" /><Setter Property="StrokeThickness" Value="0" /><Setter Property="StrokeShape" Value="{StaticResource TagShape}" /><Setter Property="Padding" Value="{StaticResource TagInset}" /><Setter Property="Margin" Value="{StaticResource TagGap}" /></Style>
 <Style x:Key="IconBadge" TargetType="Border" BasedOn="{StaticResource TagPill}"><Setter Property="WidthRequest" Value="{StaticResource TouchTarget}" /><Setter Property="HeightRequest" Value="{StaticResource TouchTarget}" /><Setter Property="Padding" Value="{StaticResource Inset8}" /><Setter Property="Margin" Value="0" /></Style>
 <Style x:Key="StudyToolbar" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="{StaticResource Inset8}" /><Setter Property="StrokeShape" Value="{StaticResource ControlShape}" /></Style>
 <Style TargetType="Entry"><Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource FontBody}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElevatedLight},Dark={StaticResource ElevatedDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight},Dark={StaticResource MutedDark}}" /><Setter Property="MinimumHeightRequest" Value="{StaticResource PrimaryTouchTarget}" /><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Focused" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight},Dark={StaticResource DisabledSurfaceDark}}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
 <Style TargetType="Editor"><Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource FontBody}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElevatedLight},Dark={StaticResource ElevatedDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight},Dark={StaticResource MutedDark}}" /><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Focused" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight},Dark={StaticResource DisabledSurfaceDark}}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
 <Style TargetType="Picker"><Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource FontBody}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElevatedLight},Dark={StaticResource ElevatedDark}}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight},Dark={StaticResource MutedDark}}" /><Setter Property="MinimumHeightRequest" Value="{StaticResource PrimaryTouchTarget}" /><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Focused" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight},Dark={StaticResource DisabledSurfaceDark}}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
 <Style TargetType="SearchBar"><Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource FontBody}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight},Dark={StaticResource MutedDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ElevatedLight},Dark={StaticResource ElevatedDark}}" /><Setter Property="CancelButtonColor" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource AccentDark}}" /><Setter Property="MinimumHeightRequest" Value="{StaticResource PrimaryTouchTarget}" /><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Focused" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight},Dark={StaticResource DisabledSurfaceDark}}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource PrimaryDark}}" /><Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" /><Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTarget}" /></Style>
 <Style TargetType="Switch"><Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource PrimaryDark}}" /><Setter Property="ThumbColor" Value="{StaticResource OnPrimary}" /><Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" /></Style>
 <Style TargetType="ProgressBar"><Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource AccentDark}}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BorderLight},Dark={StaticResource BorderDark}}" /><Setter Property="HeightRequest" Value="4" /></Style>
 <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource AccentDark}}" /></Style>
 <Style TargetType="CollectionView"><Setter Property="BackgroundColor" Value="{StaticResource Clear}" /></Style>
 <Style TargetType="Shell" ApplyToDerivedTypes="True">
  <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight},Dark={StaticResource SurfaceDark}}" /><Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource MutedLight},Dark={StaticResource MutedDark}}" /><Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource DisabledInkLight},Dark={StaticResource DisabledInkDark}}" /><Setter Property="Shell.NavBarHasShadow" Value="False" /><Setter Property="FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight},Dark={StaticResource SurfaceDark}}" />
 </Style>
</ResourceDictionary>

