<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:qvm="clr-namespace:StudySpace.App.Features.Quizzes" xmlns:svm="clr-namespace:StudySpace.App.Features.Sources">
<Style x:Key="QuestionMarker" TargetType="Border" BasedOn="{StaticResource CompactCard}"><Setter Property="WidthRequest" Value="{StaticResource MarkerWidth}" /><Setter Property="HeightRequest" Value="{StaticResource MarkerHeight}" /><Setter Property="Padding" Value="{StaticResource Inset2}" /><Setter Property="StrokeShape" Value="{StaticResource ControlShape}" /><Style.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsCurrent,x:DataType=qvm:QuestionNumberViewModel}" Value="True"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource AccentDark}}" /><Setter Property="StrokeThickness" Value="2" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="QuestionNumberButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Padding" Value="{StaticResource Inset4}" /><Setter Property="HeightRequest" Value="{StaticResource TouchTarget}" /><Style.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsCurrent,x:DataType=qvm:QuestionNumberViewModel}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent},Dark={StaticResource PrimaryDark}}" /><Setter Property="TextColor" Value="{StaticResource OnPrimary}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="QuestionStateSymbol" TargetType="Label" BasedOn="{StaticResource Caption}"><Setter Property="HorizontalTextAlignment" Value="Center" /><Style.Triggers><DataTrigger TargetType="Label" Binding="{Binding VisualState,x:DataType=qvm:QuestionNumberViewModel}" Value="Correct"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding VisualState,x:DataType=qvm:QuestionNumberViewModel}" Value="Partial"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight},Dark={StaticResource WarningDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding VisualState,x:DataType=qvm:QuestionNumberViewModel}" Value="Incorrect"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="QuizOptionCard" TargetType="Border" BasedOn="{StaticResource CompactCard}"><Style.Triggers><DataTrigger TargetType="Border" Binding="{Binding VisualState,x:DataType=qvm:QuizOptionViewModel}" Value="Correct"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSurfaceLight},Dark={StaticResource SuccessSurfaceDark}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></DataTrigger><DataTrigger TargetType="Border" Binding="{Binding VisualState,x:DataType=qvm:QuizOptionViewModel}" Value="Incorrect"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorSurfaceLight},Dark={StaticResource ErrorSurfaceDark}}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="QuizOptionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight},Dark={StaticResource InkDark}}" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
<Style x:Key="QuizOptionFeedback" TargetType="Label" BasedOn="{StaticResource Strong}"><Style.Triggers><DataTrigger TargetType="Label" Binding="{Binding VisualState,x:DataType=qvm:QuizOptionViewModel}" Value="Correct"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding VisualState,x:DataType=qvm:QuizOptionViewModel}" Value="Incorrect"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="QuizFeedbackCard" TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger TargetType="Border" Binding="{Binding FeedbackState,x:DataType=qvm:QuizRunViewModel}" Value="Correct"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></DataTrigger><DataTrigger TargetType="Border" Binding="{Binding FeedbackState,x:DataType=qvm:QuizRunViewModel}" Value="Partial"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource WarningLight},Dark={StaticResource WarningDark}}" /></DataTrigger><DataTrigger TargetType="Border" Binding="{Binding FeedbackState,x:DataType=qvm:QuizRunViewModel}" Value="Incorrect"><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="QuizFeedbackHeading" TargetType="Label" BasedOn="{StaticResource Subheading}"><Style.Triggers><DataTrigger TargetType="Label" Binding="{Binding FeedbackState,x:DataType=qvm:QuizRunViewModel}" Value="Correct"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding FeedbackState,x:DataType=qvm:QuizRunViewModel}" Value="Partial"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight},Dark={StaticResource WarningDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding FeedbackState,x:DataType=qvm:QuizRunViewModel}" Value="Incorrect"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="SourceStatusPill" TargetType="Border" BasedOn="{StaticResource TagPill}"><Style.Triggers><DataTrigger TargetType="Border" Binding="{Binding Tone,x:DataType=svm:SourceCardViewModel}" Value="Success"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSurfaceLight},Dark={StaticResource SuccessSurfaceDark}}" /></DataTrigger><DataTrigger TargetType="Border" Binding="{Binding Tone,x:DataType=svm:SourceCardViewModel}" Value="Warning"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningSurfaceLight},Dark={StaticResource WarningSurfaceDark}}" /></DataTrigger><DataTrigger TargetType="Border" Binding="{Binding Tone,x:DataType=svm:SourceCardViewModel}" Value="Error"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorSurfaceLight},Dark={StaticResource ErrorSurfaceDark}}" /></DataTrigger></Style.Triggers></Style>
<Style x:Key="SourceStatusText" TargetType="Label" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger TargetType="Label" Binding="{Binding Tone,x:DataType=svm:SourceCardViewModel}" Value="Success"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight},Dark={StaticResource SuccessDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding Tone,x:DataType=svm:SourceCardViewModel}" Value="Warning"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight},Dark={StaticResource WarningDark}}" /></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding Tone,x:DataType=svm:SourceCardViewModel}" Value="Error"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight},Dark={StaticResource ErrorDark}}" /></DataTrigger></Style.Triggers></Style>
</ResourceDictionary>

