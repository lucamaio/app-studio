<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:StudySpace.App.Features.Performance" xmlns:controls="clr-namespace:StudySpace.App.Controls"
 x:Class="StudySpace.App.Features.Performance.QuizHistoryPage" x:DataType="vm:QuizHistoryViewModel" Title="Storico quiz">
 <Grid Padding="{StaticResource PageInset}" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource Space16}">
  <VerticalStackLayout Spacing="{StaticResource Space8}"><Label Text="{Binding ProjectName}" Style="{StaticResource Muted}" /><Label Text="Il tuo percorso di studio" Style="{StaticResource Heading}" /><Button Text="Nuovo quiz" Command="{Binding NewQuizCommand}" HorizontalOptions="Start" /></VerticalStackLayout>
  <VerticalStackLayout Grid.Row="1"><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource Error}" /><Button Text="Aggiorna storico" Command="{Binding LoadCommand}" Style="{StaticResource QuietButton}" /></VerticalStackLayout>
  <Grid Grid.Row="2"><CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:HistoryItemViewModel"><Border Style="{StaticResource Card}" Margin="{StaticResource ItemGap}"><VerticalStackLayout Spacing="{StaticResource Space12}">
    <Label Text="{Binding Title}" Style="{StaticResource Subheading}" /><Label Text="{Binding Score}" FontSize="{StaticResource FontLead}" /><Label Text="{Binding Details}" Style="{StaticResource Muted}" /><Button Text="Rivedi / riprendi tentativo" Command="{Binding OpenCommand}" HorizontalOptions="Start" />
   </VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
   <CollectionView.Footer><Button Text="Carica altri tentativi" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" /></CollectionView.Footer>
  </CollectionView><controls:EmptyStateView Heading="Qui inizia il tuo percorso" Message="I tentativi compariranno qui: potrai riprenderli oppure rivedere risultati e risposte salvate." IsVisible="{Binding IsEmpty}" /></Grid>
 </Grid>
</ContentPage>

