<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:StudySpace.App.Features.Quizzes" x:Class="StudySpace.App.Features.Quizzes.QuizRunPage"
 x:DataType="vm:QuizRunViewModel" Title="Il tuo quiz">
 <Grid Padding="{StaticResource PageInset}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{StaticResource Space12}" MaximumWidthRequest="{StaticResource ContentWidth}">
  <VerticalStackLayout Spacing="{StaticResource Space6}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space8}"><Label Text="{Binding PositionLabel}" Style="{StaticResource Strong}" /><Label Grid.Column="1" Text="{Binding SaveStatus}" Style="{StaticResource Caption}" MaxLines="1" MaximumWidthRequest="{StaticResource SaveStatusWidth}" LineBreakMode="TailTruncation" /></Grid><Label Text="{Binding Summary}" Style="{StaticResource Caption}" MaxLines="2" /><ProgressBar Progress="{Binding Progress}" SemanticProperties.Description="Proporzione di domande con risposta salvata" /></VerticalStackLayout>
  <CollectionView x:Name="QuestionBar" Grid.Row="1" ItemsSource="{Binding Numbers}" SelectionMode="None" HeightRequest="{StaticResource MarkerBarHeight}" HorizontalScrollBarVisibility="Always">
   <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource Space8}" /></CollectionView.ItemsLayout>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:QuestionNumberViewModel"><Border Style="{StaticResource QuestionMarker}" Margin="{StaticResource MarkerGap}" VerticalOptions="Start"><VerticalStackLayout Spacing="0"><Button Text="{Binding Number}" Command="{Binding SelectCommand}" Style="{StaticResource QuestionNumberButton}" SemanticProperties.Description="{Binding AccessibleTitle}" /><Label Text="{Binding StateLabel}" Style="{StaticResource QuestionStateSymbol}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
  <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource Space8}"><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" /><Label Text="Valutazione in corso… La tua risposta è salvata." IsVisible="{Binding IsEvaluationRunning}" Style="{StaticResource Muted}" /><Button Text="Interrompi verifica" Command="{Binding CancelEvaluationCommand}" IsVisible="{Binding IsEvaluationRunning}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource Error}" /><Button Text="Riprova caricamento" Command="{Binding LoadCommand}" IsVisible="{Binding HasError}" Style="{StaticResource QuietButton}" /></VerticalStackLayout>
  <ScrollView Grid.Row="3"><VerticalStackLayout Spacing="{StaticResource Space16}" IsVisible="{Binding HasSession}">
   <VerticalStackLayout.Triggers><DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></VerticalStackLayout.Triggers>
   <Border Style="{StaticResource Card}"><Label Text="{Binding Prompt}" Style="{StaticResource QuestionHeading}" SemanticProperties.HeadingLevel="Level1" /></Border>
   <VerticalStackLayout Spacing="{StaticResource Space12}" IsVisible="{Binding IsClosed}" BindableLayout.ItemsSource="{Binding Options}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:QuizOptionViewModel"><Border Style="{StaticResource QuizOptionCard}"><VerticalStackLayout Spacing="{StaticResource Space8}"><Button Text="{Binding Text}" Command="{Binding ChooseCommand}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource QuizOptionButton}" /><Label Text="{Binding Feedback}" IsVisible="{Binding HasFeedback}" Style="{StaticResource QuizOptionFeedback}" /></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
   <VerticalStackLayout Spacing="{StaticResource Space8}" IsVisible="{Binding IsOpen}"><Label Text="La tua risposta" Style="{StaticResource Strong}" /><Editor Text="{Binding OpenText}" Placeholder="Spiega il concetto con parole tue…" MaxLength="8000" AutoSize="TextChanges" MinimumHeightRequest="{StaticResource AnswerHeight}" IsReadOnly="{Binding IsReadOnly}" SemanticProperties.Description="Risposta aperta, area di testo multilinea" /><Label Text="La verifica parte solo quando premi Verifica ora." Style="{StaticResource Caption}" IsVisible="{Binding IsEditable}" /><Button Text="Riprova salvataggio" Command="{Binding RetrySaveCommand}" IsVisible="{Binding IsInProgress}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" /></VerticalStackLayout>
   <Label Text="{Binding AnswerError}" IsVisible="{Binding HasAnswerError}" Style="{StaticResource Error}" />
   <VerticalStackLayout IsVisible="{Binding HasFeedback}" Spacing="{StaticResource Space16}">
    <Border Style="{StaticResource QuizFeedbackCard}"><VerticalStackLayout Spacing="{StaticResource Space12}"><Label Text="{Binding FeedbackTitle}" Style="{StaticResource QuizFeedbackHeading}" /><Label Text="{Binding FeedbackText}" /><Label Text="{Binding EvaluationDetails}" Style="{StaticResource Caption}" />
     <VerticalStackLayout Spacing="{StaticResource Space12}" IsVisible="{Binding HasOpenFeedback}"><Label Text="Cosa hai spiegato bene" Style="{StaticResource Strong}" /><Label Text="{Binding CorrectConceptsText}" /><Label Text="Cosa manca" Style="{StaticResource Strong}" /><Label Text="{Binding MissingConceptsText}" /><Label Text="Cosa è errato" Style="{StaticResource Strong}" /><Label Text="{Binding IncorrectConceptsText}" /><Label Text="Come migliorare" Style="{StaticResource Strong}" /><Label Text="{Binding SuggestionsText}" /></VerticalStackLayout>
     <Label Text="Possibile risposta completa" Style="{StaticResource Strong}" /><Label Text="{Binding IdealAnswer}" />
    </VerticalStackLayout></Border>
    <Label Text="Riferimenti per ripassare" Style="{StaticResource Subheading}" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding Citations}" Spacing="{StaticResource Space12}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:QuizCitationViewModel"><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="{StaticResource Space8}"><Label Text="{Binding Title}" Style="{StaticResource Strong}" /><Label Text="{Binding Quote}" Style="{StaticResource Muted}" /></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
   </VerticalStackLayout>
   <FlexLayout Wrap="Wrap"><Button Text="Termina quiz" Command="{Binding FinishCommand}" IsVisible="{Binding IsInProgress}" Style="{StaticResource SecondaryButton}" Margin="{StaticResource ActionGap}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CanNext}" Value="False"><Setter Property="IsVisible" Value="False" /></DataTrigger></Button.Triggers></Button><Button Text="Abbandona tentativo" Command="{Binding AbandonCommand}" IsVisible="{Binding IsInProgress}" Style="{StaticResource DangerButton}" Margin="{StaticResource ActionEndGap}" /></FlexLayout>
   <Label Text="○ Non risposta · ● Da verificare · ✓ Corretta · ✕ Errata · ◐ Parziale. La domanda corrente ha il numero evidenziato." Style="{StaticResource Caption}" /><Label Text="{Binding ProviderMessage}" Style="{StaticResource Caption}" />
  </VerticalStackLayout></ScrollView>
  <Border Grid.Row="4" Style="{StaticResource StudyToolbar}" IsVisible="{Binding HasSession}"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Border.Triggers><VerticalStackLayout Spacing="{StaticResource Space4}">
   <FlexLayout Wrap="Wrap">
    <Button Text="Verifica ora" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" IsVisible="{Binding IsOpen}" MinimumWidthRequest="{StaticResource NavigationTileWidth}" FlexLayout.Grow="1" Margin="{StaticResource ActionGap}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding HasFeedback}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger><DataTrigger TargetType="Button" Binding="{Binding IsInProgress}" Value="False"><Setter Property="IsVisible" Value="False" /></DataTrigger></Button.Triggers></Button>
    <Button Text="Termina quiz" Command="{Binding FinishCommand}" IsVisible="{Binding IsInProgress}" MinimumWidthRequest="{StaticResource NavigationTileWidth}" FlexLayout.Grow="1" Margin="{StaticResource ActionEndGap}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding CanNext}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></Button.Triggers></Button>
    <Button Text="Riprova valutazioni" Command="{Binding RetryEvaluationCommand}" IsVisible="{Binding IsPending}" FlexLayout.Grow="1" Margin="{StaticResource ActionEndGap}" />
    <Button Text="Apri risultato" Command="{Binding ShowResultsCommand}" IsVisible="{Binding IsCompleted}" FlexLayout.Grow="1" Margin="{StaticResource ActionEndGap}" />
   </FlexLayout>
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space4}"><Button Text="← Prima" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" Style="{StaticResource QuietButton}" Padding="{StaticResource Inset6}" SemanticProperties.Description="Domanda precedente" /><Button Grid.Column="1" Text="Esci" Command="{Binding ExitCommand}" Style="{StaticResource QuietButton}" Padding="{StaticResource Inset6}" SemanticProperties.Description="Salva le risposte e lascia il tentativo in pausa" /><Button Grid.Column="2" Text="Dopo →" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Style="{StaticResource QuietButton}" Padding="{StaticResource Inset6}" SemanticProperties.Description="Domanda successiva" /></Grid>
  </VerticalStackLayout></Border>
 </Grid>
</ContentPage>

