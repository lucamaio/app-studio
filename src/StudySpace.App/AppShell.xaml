<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="StudySpace.App.AppShell" Title="StudySpace"
       FlyoutBehavior="Flyout">
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="{StaticResource PageInset}" Spacing="{StaticResource Space6}">
            <Label Text="StudySpace" Style="{StaticResource Heading}" />
            <Label Text="Il tuo spazio per imparare." Style="{StaticResource Muted}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>
</Shell>

